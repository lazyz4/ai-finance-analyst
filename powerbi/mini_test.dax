// ============================================================================
// 最小测试脚本：用来判断「使用更改更新模型」按钮为什么是灰的
//
// 用法：在 DAX 查询视图里新建一个查询标签页（或清空当前内容），
//       把下面全部内容粘进去，按 F5 运行，然后看按钮有没有变成可用。
//
// 结果怎么读：
//   按钮变可用  -> 说明环境没问题，是我那份大脚本里有东西不被接受，
//                  回来告诉我，我逐段排查（重点怀疑中文表名）
//   按钮还是灰的 -> 说明是这个 Power BI 版本/环境本身不支持，
//                  那就改用逐条新建的路子，我给你出一份精简到 15 条的版本
// ============================================================================

DEFINE
    MEASURE '年度透视'[测试度量值一] = 1
    MEASURE '年度透视'[测试度量值二] = 2

EVALUATE
    ROW ( "测试", "两个测试度量值已定义" )
